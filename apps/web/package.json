{
  "name": "wealth-copilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icons.mjs && node scripts/gen-forms.mjs && vite --configLoader native",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run --configLoader native",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src tests scripts vite.config.ts vitest.config.ts eslint.config.js tsconfig.json package.json index.html",
    "gen:api": "node scripts/generate-api.mjs",
    "gen:forms": "node scripts/gen-forms.mjs",
    "budget": "node scripts/budget.mjs",
    "gen:copy": "node scripts/generate-copy.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.63.0",
    "oidc-client-ts": "3.5.0",
    "openapi-typescript": "7.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "7.18.5",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.6",
    "js-yaml": "^4.3.2",
    "jsdom": "30.1.3",
    "msw": "^2.15.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
