{
  "$defs": {
    "Compounding": {
      "enum": [
        "simple",
        "monthly",
        "quarterly",
        "half_yearly",
        "yearly"
      ],
      "title": "Compounding",
      "type": "string"
    },
    "PayoutType": {
      "enum": [
        "cumulative",
        "monthly",
        "quarterly",
        "half_yearly",
        "yearly"
      ],
      "title": "PayoutType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_type": {
      "const": "fd",
      "title": "Asset Type",
      "type": "string"
    },
    "bank": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Bank",
      "type": "string"
    },
    "compounding": {
      "$ref": "#/$defs/Compounding",
      "default": "quarterly"
    },
    "joint": {
      "default": false,
      "title": "Joint",
      "type": "boolean"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "maturity": {
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "type": "string"
    },
    "member_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Member Id"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "payout": {
      "$ref": "#/$defs/PayoutType",
      "default": "cumulative"
    },
    "principal": {
      "format": "decimal",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
      "type": "string",
      "x-unit": "INR"
    },
    "rate_pct": {
      "format": "decimal",
      "pattern": "^(0|[1-9][0-9]?)(\\.[0-9]{1,4})?$",
      "type": "string",
      "x-maximum": "30",
      "x-minimum": "0"
    },
    "start": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "asset_type",
    "bank",
    "principal",
    "rate_pct",
    "maturity"
  ],
  "title": "FixedDepositAsset",
  "type": "object"
}
