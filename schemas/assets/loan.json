{
  "additionalProperties": false,
  "properties": {
    "asset_type": {
      "const": "loan",
      "title": "Asset Type",
      "type": "string"
    },
    "currency": {
      "default": "INR",
      "enum": [
        "INR",
        "DKK",
        "EUR"
      ],
      "title": "Currency",
      "type": "string"
    },
    "emi": {
      "anyOf": [
        {
          "format": "decimal",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Emi"
    },
    "emi_day": {
      "anyOf": [
        {
          "maximum": 28,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Emi Day"
    },
    "end": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "joint": {
      "default": false,
      "title": "Joint",
      "type": "boolean"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "lender": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lender"
    },
    "loan_kind": {
      "enum": [
        "home",
        "car",
        "personal",
        "education",
        "credit_card",
        "gold",
        "other"
      ],
      "title": "Loan Kind",
      "type": "string"
    },
    "member_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Member Id"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "original_amount": {
      "anyOf": [
        {
          "format": "decimal",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Amount"
    },
    "outstanding": {
      "format": "decimal",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
      "type": "string"
    },
    "outstanding_as_of": {
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "type": "string"
    },
    "rate_pct": {
      "format": "decimal",
      "pattern": "^(0|[1-9][0-9]?)(\\.[0-9]{1,4})?$",
      "type": "string",
      "x-maximum": "60",
      "x-minimum": "0"
    },
    "rate_type": {
      "anyOf": [
        {
          "enum": [
            "fixed",
            "floating"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rate Type"
    },
    "start": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tax_relief": {
      "default": "none",
      "enum": [
        "none",
        "in_home_self_occupied",
        "in_home_let_out",
        "in_education",
        "dk_interest_deduction"
      ],
      "title": "Tax Relief",
      "type": "string"
    }
  },
  "required": [
    "asset_type",
    "loan_kind",
    "outstanding",
    "rate_pct"
  ],
  "title": "LoanAsset",
  "type": "object"
}
