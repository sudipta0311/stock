{
  "additionalProperties": false,
  "properties": {
    "asset_type": {
      "const": "savings",
      "title": "Asset Type",
      "type": "string"
    },
    "balance": {
      "format": "decimal",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
      "type": "string",
      "x-unit": "INR"
    },
    "bank": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Bank",
      "type": "string"
    },
    "joint": {
      "default": false,
      "title": "Joint",
      "type": "boolean"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "member_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Member Id"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "asset_type",
    "bank",
    "balance"
  ],
  "title": "SavingsAsset",
  "type": "object"
}
